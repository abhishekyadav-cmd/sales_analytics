select
      count(*) as failures,
      count(*) != 0 as should_warn,
      count(*) != 0 as should_error
    from (
      with line_totals as (
    select
        order_id,
        sum(round(extended_price * (1 - discount_percentage) * (1 + tax_rate), 2)) as computed_total
    from ANALYTICS.PUBLIC_STAGING.stg_tpch__lineitems
    group by order_id
),
orders as (
    select
        order_id,
        total_price
    from ANALYTICS.PUBLIC_STAGING.stg_tpch__orders
)

select
    o.order_id,
    o.total_price,
    l.computed_total,
    abs(o.total_price - l.computed_total) as diff
from orders o
join line_totals l on o.order_id = l.order_id
-- Rounding differences ke liye 1 unit se zyada deviation check karega
where abs(o.total_price - l.computed_total) > 1.00
      
    ) dbt_internal_test
