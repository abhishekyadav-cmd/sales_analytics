   as (
    with customers as (
    select * from ANALYTICS.PUBLIC_STAGING.stg_tpch__customers
),
nations as (
    select * from ANALYTICS.PUBLIC_STAGING.stg_tpch__nations
),
regions as (
    select * from ANALYTICS.PUBLIC_STAGING.stg_tpch__regions
)

select
    c.customer_id,
    c.customer_name,
    c.address,
    c.phone_number,
    c.account_balance,
    c.market_segment,
    n.nation_name,
    r.region_id,
    r.region_name
