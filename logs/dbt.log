[0m22:31:29.749096 [debug] [Thread-2 (]: On model.sales_analytics.rpt_region_sales_vs_target: /* {"app": "dbt", "dbt_version": "1.9.4", "profile_name": "sales_analytics", "target_name": "dev", "node_id": "model.sales_analytics.rpt_region_sales_vs_target"} */
create or replace transient table ANALYTICS.PUBLIC_MARTS.rpt_region_sales_vs_target
         as
        (with actual_sales as (
    select
        region_name,
        extract(year from order_date) as sales_year,
        sum(net_revenue) as actual_revenue
    from ANALYTICS.PUBLIC_MARTS.fct_order_lines
    group by 1, 2
),
targets as (
    select
        region_name,
        target_year,
        sales_target
    from ANALYTICS.PUBLIC_STAGING.stg_raw__region_targets
)

select
    coalesce(a.region_name, t.region_name) as region_name,
    coalesce(a.sales_year, t.target_year) as year,
    coalesce(a.actual_revenue, 0) as actual_revenue,
    coalesce(t.sales_target, 0) as target_revenue,
    coalesce(a.actual_revenue, 0) - coalesce(t.sales_target, 0) as variance_amount,
    case 
        when coalesce(t.sales_target, 0) = 0 then null
        else round(((coalesce(a.actual_revenue, 0) - t.sales_target) / t.sales_target) * 100, 2)
    end as variance_pct
from actual_sales a
full outer join targets t 
    on a.region_name = t.region_name 
   and a.sales_year = t.target_year
        );
